    }
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "((671, 12), (60, 12))"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df = df.sort_values(\"dteday\").reset_index(drop=True)\n",
    "split_date = df[\"dteday\"].max() - pd.Timedelta(days=60)\n",
    "\n",
    "train = df[df[\"dteday\"] <= split_date]\n",
    "test = df[df[\"dteday\"] > split_date]\n",
    "\n",
    "train.shape, test.shape"
   ]
  },
